enum E_GTA_WEATHER_REGION {
    GTA_WEATHER_REGION_DEFAULT,
    GTA_WEATHER_REGION_LOS_SANTOS,
    GTA_WEATHER_REGION_SAN_FIERRO,
    GTA_WEATHER_REGION_LAS_VENTURAS,
    GTA_WEATHER_REGION_DESERT
};

static gGTAWeatherCycleStage;
static E_GTA_WEATHER_REGION:gGTAWeatherPlayerRegion[MAX_PLAYERS];
static bool:gGTAWeatherPlayerInitialized[MAX_PLAYERS];

static stock E_GTA_WEATHER:GTAWeather_GetWeatherForStage(E_GTA_WEATHER_REGION:region, stage) {
    if(stage < 0 || stage >= GTA_WEATHER_CYCLE_LENGTH)
        return E_GTA_WEATHER:-1;

    switch(region) {
        case GTA_WEATHER_REGION_DEFAULT:
            return gWeatherTypesListDefault[stage];
        case GTA_WEATHER_REGION_LOS_SANTOS:
            return gWeatherTypesListLA[stage];
        case GTA_WEATHER_REGION_SAN_FIERRO:
            return gWeatherTypesListSF[stage];
        case GTA_WEATHER_REGION_LAS_VENTURAS:
            return gWeatherTypesListVegas[stage];
        case GTA_WEATHER_REGION_DESERT:
            return gWeatherTypesListDesert[stage];
    }

    return E_GTA_WEATHER:-1;
}


/*
* --------------------------------------------------------------------------
* USABLE FUNCTIONS
* --------------------------------------------------------------------------
*/

/*
* https://github.com/gta-reversed/gta-reversed/blob/master/source/game_sa/Weather.cpp
*/
stock E_GTA_WEATHER_REGION:GTAWeather_GetRegion(Float:x, Float:y) {
    if (x <= 1000.0 || y <= 910.0) {
        if (x <= -850.0 || x >= 1000.0 || y <= 1280.0) {
            if (x >= -1430.0 || y <= -580.0 || y >= 1430.0) {
                if (x <= 250.0 || x >= 3000.0 || y <= -3000.0 || y >= -850.0) {
                    return GTA_WEATHER_REGION_DEFAULT;
                }
                return GTA_WEATHER_REGION_LOS_SANTOS;
            }
            return GTA_WEATHER_REGION_SAN_FIERRO;
        }
        return GTA_WEATHER_REGION_DESERT;
    }
    return GTA_WEATHER_REGION_LAS_VENTURAS;
}

/*
* Set a weather stage
*/
stock bool:GTAWeather_SetStage(stage) {
    if(stage < 0 || stage >= GTA_WEATHER_CYCLE_LENGTH)
        return false;

    gGTAWeatherCycleStage = stage;
    return true;
}

stock GTAWeather_GetStage() {
    return gGTAWeatherCycleStage;
}

/*
* Advances the weather stage
*/
stock GTAWeather_Advance() {
    gGTAWeatherCycleStage++;

    if(gGTAWeatherCycleStage >= GTA_WEATHER_CYCLE_LENGTH)
        gGTAWeatherCycleStage = 0;

    return gGTAWeatherCycleStage;
}

/*
* Returns the current weather for a region.
*/
stock E_GTA_WEATHER:GTAWeather_GetWeather(E_GTA_WEATHER_REGION:region) {
    return GTAWeather_GetWeatherForStage(region, gGTAWeatherCycleStage);
}

/*
* Returns the current weather for position
*/
stock E_GTA_WEATHER:GTAWeather_GetWeatherAt(Float:x, Float:y) {
    return GTAWeather_GetWeather(GTAWeather_GetRegion(x, y));
}

/*
* Resets player data related to weather
*/
stock bool:GTAWeather_ResetPlayer(playerid) {
    if(playerid < 0 || playerid >= MAX_PLAYERS)
        return false;

    gGTAWeatherPlayerRegion[playerid] = GTA_WEATHER_REGION_DEFAULT;
    gGTAWeatherPlayerInitialized[playerid] = false;
    return true;
}

/*
* Sets the player's weather according to the weather cycle and position. Weather interpolation done by the client
*/
stock bool:GTAWeather_UpdatePlayer(playerid, bool:force = false) {
    if(playerid < 0 || playerid >= MAX_PLAYERS)
        return false;

    new Float:x, Float:y, Float:z;
    if(!GetPlayerPos(playerid, x, y, z))
        return false;

    new E_GTA_WEATHER_REGION:region = GTAWeather_GetRegion(x, y);

    if(!force && gGTAWeatherPlayerInitialized[playerid] && gGTAWeatherPlayerRegion[playerid] == region)
        return true;

    new E_GTA_WEATHER:weather = GTAWeather_GetWeather(region);
    if(_:weather < 0)
        return false;

    gGTAWeatherPlayerRegion[playerid] = region;
    gGTAWeatherPlayerInitialized[playerid] = true;

    SetPlayerWeather(playerid, _:weather);
    return true;
}
